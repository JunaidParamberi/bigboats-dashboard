# Big Boats UAE — Environment variables
# Copy to .env and fill in real values. NEVER commit .env.

# ── LOCAL DEV (node server.js) ──
MAKE_GET_CONVERSATIONS_URL=https://hook.eu1.make.com/your_get_conversations_hook
MAKE_SEND_REPLY_URL=https://hook.eu1.make.com/your_send_reply_hook
MAKE_TAKEOVER_URL=https://hook.eu1.make.com/your_takeover_hook
PORT=3000

# ── VERCEL PRODUCTION (api/*.js) ──
# Single unified Make webhook that handles all actions via the "action" field
MAKE_DASHBOARD_WEBHOOK_URL=your_unified_make_dashboard_webhook_url
DASHBOARD_API_KEY=your_private_api_key_here
