# Big Boats UAE — Dashboard environment variables
# Copy this file to .env and fill in the real values.
# NEVER commit .env to version control.

# The Make.com webhook URL that handles all dashboard actions:
#   action: get_conversations | get_messages | reply | takeover
MAKE_DASHBOARD_WEBHOOK_URL=your_make_dashboard_webhook_url_here

# A secret key you choose — used in Authorization: Bearer header
# from the server to Make.com, so Make can verify the request source.
DASHBOARD_API_KEY=your_private_api_key_here
